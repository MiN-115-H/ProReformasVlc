{
  "framework": "vite",
  "buildCommand": "npm run build:frontend",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://proreformas-laravel.onrender.com/api/:path*"
    },
    {
      "source": "/auth/:path*",
      "destination": "https://proreformas-laravel.onrender.com/auth/:path*"
    },
    {
      "source": "/csrf-token",
      "destination": "https://proreformas-laravel.onrender.com/csrf-token"
    },
    {
      "source": "/storage/:path*",
      "destination": "https://proreformas-laravel.onrender.com/storage/:path*"
    },
    {
      "source": "/img/:path*",
      "destination": "/img/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
